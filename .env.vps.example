# Forge IA — variables d'environnement VPS (copie en .env.vps, NE PAS committer)
# Génère les secrets :  openssl rand -hex 24

# Clé de chiffrement n8n (STABLE — ne plus jamais la changer après le 1er démarrage)
N8N_ENCRYPTION_KEY=

# Clé Mistral (RÉGÉNÉRÉE sur console.mistral.ai — l'ancienne a été exposée)
MISTRAL_API_KEY=

# Clé Groq (OPTIONNELLE — agent Documentation ; peut rester vide)
GROQ_API_KEY=

# Jeton du service mémoire (partagé n8n <-> forge-memory)
MEMORY_TOKEN=

# Authentification du panneau
FORGE_USER=forge
FORGE_PASS=

# Sous-domaine public du panneau (ex. forge.tondomaine.bj)
FORGE_DOMAIN=forge.tondomaine.xx

# Clé Tchavi (passerelle modèles premium, compatible OpenAI)
TCHAVI_API_KEY=
