PORT=3000
NODE_ENV=production

# URLs du pipeline n8n et du service de deploiement (surchargent les valeurs par defaut du VPS)
N8N_URL=http://167.86.93.31:5688/webhook/pipeline
DEPLOY_URL=http://167.86.93.31:4001

# Autorise les origines cross-site a appeler l'API avec credentials (liste separee par des virgules).
# Laisser vide si l'outil est utilise uniquement en meme origine (recommande).
CORS_ORIGIN=

# ── Authentification (Sprint 2) ──────────────────────────────────────────
# Secret de signature JWT — genere aleatoirement, jamais commite.
# Generer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Identifiant admin seede au demarrage (pas d'inscription publique).
ADMIN_USERNAME=admin

# Hash bcrypt du mot de passe admin — jamais le mot de passe en clair.
# Generer avec : npm run hash-password -- "VotreMotDePasse"
ADMIN_PASSWORD_HASH=
