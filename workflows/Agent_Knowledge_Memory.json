    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nlet data = raw;\nif (raw.body !== undefined) {\n  let rawBody = raw.body;\n  if (typeof rawBody === 'string') {\n    rawBody = rawBody.replace(/^=+/, '').trim();\n    try { data = JSON.parse(rawBody); } catch(e) { data = raw; }\n  } else if (typeof rawBody === 'object') {\n    data = rawBody;\n  }\n}\n\nconst task_id   = data.task_id   || raw.task_id   || 'TASK-KNOWLEDGE-' + Date.now();\nconst operation = data.operation || raw.operation || 'WRITE';\nconst category  = data.category  || raw.category  || 'deployment';\nconst knowledge = data.data      || raw.data      || {};\n\nreturn [{\n  json: {\n    task_id:   String(task_id),\n    operation: String(operation),\n    category:  String(category),\n    data:      knowledge\n  }\n}];"
      },
