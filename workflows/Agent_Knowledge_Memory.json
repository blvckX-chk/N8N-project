      "id": "b188c54a-5fba-46fe-bfce-48c84a3900e6",
      "name": "Format Error"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet content = {};\ntry {\n  content = typeof input.content_json === 'string'\n    ? JSON.parse(input.content_json)\n    : input.content_json || {};\n} catch(e) {\n  content = { raw: input.content_json };\n}\n\nconst entry_id = `${input.category}-${input.project}-${Date.now()}`;\n\nreturn [{\n  json: {\n    task_id: input.task_id,\n    operation: 'WRITE',\n    status: 'STORED',\n    entry_id,\n    category: input.category,\n    project: input.project,\n    environment: input.environment,\n    agent_source: input.agent_source,\n    content,\n    message: `Entrée ${entry_id} stockée dans la catégorie ${input.category}`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
