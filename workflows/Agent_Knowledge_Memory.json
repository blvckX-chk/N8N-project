        416
      ],
      "id": "39efa0f9-be9f-441d-afa9-b0445f342fe9",
      "name": "Store Logic"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nreturn [{\n  json: {\n    task_id: input.task_id,\n    operation: 'READ',\n    status: 'RETRIEVED',\n    category: input.category,\n    project: input.project,\n    environment: input.environment,\n    entries: [],\n    count: 0,\n    message: `Aucune entrée trouvée pour ${input.category}/${input.project}`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        592
      ],
      "id": "6ee03a2f-93a8-4355-a57b-17d480d914ad",
      "name": "Retrieve Logic"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst isSuccess = input.status === 'STORED' || input.status === 'RETRIEVED';\n\nreturn [{\n  json: {\n    success: isSuccess,\n    agent: \"Agent Knowledge/Memory\",\n    task_id: input.task_id,\n    status: isSuccess ? \"PASS\" : \"FAIL\",\n    global_score: isSuccess ? 100 : 0,\n    approved_for_pipeline: isSuccess,\n    language: \"javascript\",\n    critical_issues: [],\n    warnings: [],\n    recommendations: isSuccess\n      ? [`Opération ${input.operation} réussie`]\n      : [`Échec de l'opération ${input.operation}`],\n    summary: input.message || `Opération ${input.operation}`,\n    dimensions: { security: { score: 100 }, quality: { score: 100 } },\n    operation: input.operation,\n    entry_id: input.entry_id || null,\n    timestamp: input.timestamp || new Date().toISOString()\n  }\n}];"
      },
