# Copie ce fichier en .env (non versionné) et renseigne les clés utiles.

# Port du panneau web (défaut : 3200)
PORT=3200

# Clé API Mistral — si présente, l'IA rédige le contenu ; sinon repli déterministe.
# https://console.mistral.ai/
MISTRAL_API_KEY=

# Token Netlify pour le déploiement statique automatisé (bouton "Déployer").
# https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=
